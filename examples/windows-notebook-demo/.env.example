# CubeAPI on Kunpeng (change IP if needed)
E2B_API_URL=http://10.50.156.199:3000

# Any non-empty value when auth is disabled
E2B_API_KEY=e2b_000000

# Template ID from: cubemastercli tpl list  (status READY)
CUBE_TEMPLATE_ID=<your-template-id>

# mkcert root CA copied from Kunpeng (see README_zh.md)
# Default location on Kunpeng (root install):
#   /root/.local/share/mkcert/rootCA.pem
SSL_CERT_FILE=C:\certs\cube-rootCA.pem
REQUESTS_CA_BUNDLE=C:\certs\cube-rootCA.pem

# CubeAPI on Kunpeng (local control plane)
E2B_API_URL=http://127.0.0.1:3000
E2B_API_KEY=e2b_000000

# Template ID from: cubemastercli tpl list  (status READY)
CUBE_TEMPLATE_ID=<your-template-id>

# mkcert root CA on Kunpeng (see README_zh.md)
SSL_CERT_FILE=/root/.local/share/mkcert/rootCA.pem
REQUESTS_CA_BUNDLE=/root/.local/share/mkcert/rootCA.pem

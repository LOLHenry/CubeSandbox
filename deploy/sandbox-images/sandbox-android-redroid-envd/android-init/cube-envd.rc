# CubeSandbox envd for ReDroid cubebox templates.
# envd-starter (PID1) only execs /init; Android init starts envd here.
# Must start on `on init` — post-fs-data is often after the 30s template probe window.

service cube_envd /usr/bin/envd -port 49983
    class main
    user root
    group root

on init
    start cube_envd

on post-fs-data
    mkdir /data/local/tmp 0771 system shell
    restart cube_envd

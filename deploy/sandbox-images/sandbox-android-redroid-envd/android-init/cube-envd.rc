# CubeSandbox envd for ReDroid cubebox templates.
# envd-starter only execs /init; Android init starts envd here (no /system/bin/sh).

service cube_envd /usr/bin/envd -port 49983
    class main
    user root
    group root
    seclabel u:r:su:s0

on init
    start cube_envd

on post-fs-data
    mkdir /data/local/tmp 0771 system shell
    restart cube_envd

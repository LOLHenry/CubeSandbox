{
  "kit_id": "agr-mobile-replication-kit",
  "kit_version": "1.0.0",
  "target_platform": "kunpeng-arm64",
  "description": "Offline package to replicate AGR Mobile dual-channel (envd+ADB) on CubeSandbox",
  "agr_probes": [
    {
      "sequence": "01",
      "date": "2026-07-23",
      "topic": "mobile-hardware-mock",
      "doc": "docs/probes/01-20260723-mobile-hardware-mock.md",
      "external_doc": "https://github.com/LOLHenry/android-cuttlefish/blob/main/docs/experiments/tencent-agent-runtime-mobile-hardware-mock.md"
    },
    {
      "sequence": "02",
      "date": "2026-08-24",
      "topic": "mobile-architecture",
      "doc": "docs/probes/02-20260824-mobile-architecture.md",
      "artifacts": "probe/artifacts/02-20260824-ap-shanghai/"
    }
  ],
  "agr_reference_probe_date": "2026-08-24",
  "agr_reference_region": "ap-shanghai",
  "agr_reference_doc": "docs/probes/README.md",
  "components": {

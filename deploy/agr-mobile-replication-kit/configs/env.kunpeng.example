# 鲲鹏机环境变量（复制为 .env）
# cp configs/env.kunpeng.example .env

# --- 镜像 ---
IMAGE_TAG=sandbox-android-redroid-envd:16.0.0-arm64
ENVD_REF=2026.16
REDROID_TAG=16.0.0_64only-latest

# --- CubeSandbox（已 one-click 安装）---
CUBEMASTER_URL=http://127.0.0.1:8089
# 黄区无 registry 时模板用本地短名
TEMPLATE_IMAGE=${IMAGE_TAG}

# --- 模板资源（对齐 AGR 实测 ~4.6核/8.7Gi，鲲鹏 ReDroid16 推荐 4核/6Gi）---
TEMPLATE_CPU=4000
TEMPLATE_MEMORY=6144
TEMPLATE_WRITABLE_LAYER=10Gi
TEMPLATE_PROBE_PORT=49983
TEMPLATE_PROBE_PATH=/health
EXPOSE_PORTS="5555 49983"

# --- 离线包路径（02-install 后自动设置）---
# KIT_ROOT=/opt/agr-mobile-replication-kit-kunpeng-arm64

# --- 可选：对照 AGR 云端探测 ---
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# AGR_REGION=ap-shanghai
# E2B_DOMAIN=ap-shanghai.tencentags.com
# AGR_MOBILE_TOOL_ID=sdt-n5tzhruw

# --- 可选：外网 adb/envd（network-agent）---
# HOST_PROXY_BIND_IP=0.0.0.0
